class_name ChapterTheme
extends RefCounted
## v1.1: each chapter has its own look: a painted background (generated by
## tools/make_backgrounds.py), an accent colour and a name. Textures are
## loaded once and cached.

const THEMES := {
	1: {"key": "studio", "bg": "res://assets/backgrounds/ch1.jpg", "accent": Color("#B9A0E5"),
		"board_top": Color("#2a2338"), "board_bottom": Color("#1c1828"), "screen": Color("#191622")},
	2: {"key": "garden", "bg": "res://assets/backgrounds/ch2.jpg", "accent": Color("#7ED6A3"),
		"board_top": Color("#1d3330"), "board_bottom": Color("#131f1d"), "screen": Color("#121c1b")},
	3: {"key": "lab", "bg": "res://assets/backgrounds/ch3.jpg", "accent": Color("#69AEFF"),
		"board_top": Color("#1c2940"), "board_bottom": Color("#121827"), "screen": Color("#111622")},
	4: {"key": "volcano", "bg": "res://assets/backgrounds/ch4.jpg", "accent": Color("#FF8A4C"),
		"board_top": Color("#2e181b"), "board_bottom": Color("#190e11"), "screen": Color("#170d10")},
	5: {"key": "space", "bg": "res://assets/backgrounds/ch5.jpg", "accent": Color("#A58BFF"),
		"board_top": Color("#17173a"), "board_bottom": Color("#0a0a16"), "screen": Color("#090912")},
}

static var _cache := {}


static func chapter_of(lv: Dictionary) -> int:
	var c := str(lv.get("chapter", 1)).replace(".0", "")
	return int(c) if c.is_valid_int() else 1


static func of_chapter(chapter: int) -> Dictionary:
	return THEMES.get(chapter, THEMES[1])


static func of_level(lv: Dictionary) -> Dictionary:
	return of_chapter(chapter_of(lv))


static func background(chapter: int) -> Texture2D:
	if not _cache.has(chapter):
		var path: String = of_chapter(chapter).bg
		_cache[chapter] = load(path) if ResourceLoader.exists(path) else null
	return _cache[chapter]
